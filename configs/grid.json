{
 "defaults": {"split": "test", "sets": ["cord", "invoices"], "budget_usd": 15.0, "workers": 8},
 "runs": [
  {"name": "luna-6",           "model": "gpt-6-luna", "samples": 5},
  {"name": "terra-6.1",        "model": "gpt-6.1-terra"},
  {"name": "sol-6.1",          "model": "gpt-6.1-sol"},
  {"name": "gpt-4.1-mini-lp",  "model": "gpt-4.1-mini", "logprobs": true, "samples": 5},

  {"name": "luna-6-ocr",        "model": "gpt-6-luna", "input_mode": "ocr"},
  {"name": "luna-6-gt_text",    "model": "gpt-6-luna", "input_mode": "gt_text"},
  {"name": "luna-6-image+ocr",  "model": "gpt-6-luna", "input_mode": "image+ocr"},
  {"name": "sol-6.1-ocr",       "model": "gpt-6.1-sol", "input_mode": "ocr"},
  {"name": "sol-6.1-gt_text",   "model": "gpt-6.1-sol", "input_mode": "gt_text"},
  {"name": "sol-6.1-image+ocr", "model": "gpt-6.1-sol", "input_mode": "image+ocr"},

  {"name": "luna-6-free",   "model": "gpt-6-luna", "output_mode": "free"},
  {"name": "terra-6.1-free", "model": "gpt-6.1-terra", "output_mode": "free"},
  {"name": "sol-6.1-free",  "model": "gpt-6.1-sol", "output_mode": "free"},

  {"name": "luna-6-v2",  "model": "gpt-6-luna", "prompt": "v2"},
  {"name": "terra-6.1-v2", "model": "gpt-6.1-terra", "prompt": "v2"},
  {"name": "sol-6.1-v2", "model": "gpt-6.1-sol", "prompt": "v2"},

  {"name": "luna-6-degrade",  "model": "gpt-6-luna", "sets": ["degrade"], "repair": 0},
  {"name": "terra-6.1-degrade", "model": "gpt-6.1-terra", "sets": ["degrade"], "repair": 0},
  {"name": "sol-6.1-degrade", "model": "gpt-6.1-sol", "sets": ["degrade"], "repair": 0}
 ]
}
